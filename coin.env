# Coin-specific config for the Flux HA masternode template.
# The generic scripts are identical across coins; only this file changes per coin.
# All values verified against NeoxaChain/Neoxa source (Ravencoin base + Dash DIP3 — see README).
COIN_TICKER="NEOX"
COIN_DAEMON="neoxad"
COIN_CLI_BIN="neoxa-cli"
DATADIR="/root/.neoxacore"              # default dir .neoxacore (util.cpp:641)
CONF="${DATADIR}/neoxa.conf"            # BITCOIN_CONF_FILENAME (util.cpp:111)
MN_PORT=8788                            # CMainParams nDefaultPort (chainparams.cpp:438)
BLS_PARAM="smartnodeblsprivkey"         # rpcevo.cpp:1332; init.cpp:670 (NEOX uses smartnode naming)
SEED_NODES=""
CLI="${COIN_CLI_BIN} -datadir=${DATADIR} -conf=${CONF}"
